# Copy to .env locally. Never commit or include .env in a handoff archive.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-realtime
# Captions inside the Realtime session; not a separate STT service.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE=marin
HOST=127.0.0.1
PORT=4173
# Required if HOST is not loopback. This is a site access code, not an OpenAI key.
APP_ACCESS_TOKEN=
MAX_REQUESTS_PER_MINUTE=30
API_TIMEOUT_MS=60000
# TRUST_SITES_GATE is only for a Worker behind a confirmed private hosting gate.
# The portable Node server always ignores that flag.
